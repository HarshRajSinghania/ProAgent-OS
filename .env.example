# ProAgent OS environment
PROAGENT_ADMIN_KEY=change-me-admin-key
PROAGENT_DB_PATH=./data/proagent.db

# LLM provider: mock (offline) | openai (OpenAI-compatible HTTP)
PROAGENT_LLM_PROVIDER=mock
# When PROAGENT_LLM_PROVIDER=openai:
#   PROAGENT_LLM_BASE_URL  — API base ending in /v1 (OpenAI, Azure OpenAI proxy, vLLM, Ollama openai compat, etc.)
#   PROAGENT_LLM_API_KEY   — Bearer token (required for real calls; if empty, factory falls back to mock)
#   PROAGENT_LLM_MODEL     — model id sent to /chat/completions
# PROAGENT_LLM_PROVIDER=openai
# PROAGENT_LLM_BASE_URL=https://api.openai.com/v1
# PROAGENT_LLM_API_KEY=sk-...
# PROAGENT_LLM_MODEL=gpt-4o-mini

# Specialist multi-step tool loop limit (default 8)
PROAGENT_MAX_TOOL_ROUNDS=8

# Knowledge-base retrieval: bm25 (default) | hybrid | vector
# hybrid score = alpha * max-norm(cosine) + (1 - alpha) * max-norm(bm25)
# Embeddings in this release are an offline stub (no extra packages).
# sqlite-vec and remote embedders are not wired; missing vectors fall back to BM25.
PROAGENT_KB_RETRIEVAL=bm25
PROAGENT_KB_EMBED_BACKEND=stub
PROAGENT_KB_EMBED_DIMS=64
PROAGENT_KB_HYBRID_ALPHA=0.5

PROAGENT_HOST=0.0.0.0
PROAGENT_PORT=8080
PROAGENT_SKILLS_DIRS=./skills,./verticals/example/skills
PROAGENT_AGENTS_CONFIG=./config/agents.yaml
